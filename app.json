{
  "expo": {
    "name": "MatAnalyst",
    "slug": "gsl-bjj-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDE9DF",
    "splash": {
      "backgroundColor": "#EDE9DF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gsl.bjjtracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDE9DF"
      },
      "package": "com.gsl.bjjtracker",
      "screenOrientation": "portrait"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "MatAnalyst",
      "shortName": "MatAnalyst",
      "description": "BJJ analytics and training tracker by Grounded Skills Lab",
      "themeColor": "#C95F3D",
      "backgroundColor": "#EDE9DF",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
